FROM node:22-alpine

WORKDIR /app

ARG MEDIAWALL_API_ORIGIN
ENV MEDIAWALL_API_ORIGIN=${MEDIAWALL_API_ORIGIN}
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json ./
RUN npm install --no-audit --no-fund

COPY . .
RUN npm run build

ENV NODE_ENV=production
EXPOSE 3000
CMD ["npm", "run", "start", "--", "--hostname", "0.0.0.0", "--port", "3000"]
